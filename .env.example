# Telegram bot token — get this from @BotFather (Phase 2)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API key — used by the AI Report Generator (Phase 13)
OPENAI_API_KEY=your_openai_api_key_here

# Max upload size in MB — enforced in Phase 3
MAX_UPLOAD_SIZE_MB=500

# Where extracted projects are temporarily stored
UPLOAD_DIR=data/uploads
